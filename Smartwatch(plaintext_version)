import requests
import random
from time import sleep

# Adjust the server URL as needed
FLASK_SERVER_URL = "http://10.0.0.212:5000/data"

while True:
    data_json = {"heart_rate": random.randint(60, 120)}
    print(f"[Smartwatch] Sending JSON: {data_json}")
    try:
        response = requests.post(FLASK_SERVER_URL, json=data_json)
        print(f"[Smartwatch] Status Code: {response.status_code}")
    except Exception as e:
        print(f"[Smartwatch] Error: {e}")
    
    sleep(2)
